# ==========================================
# REST_OTM — Environment Variables Template
# ==========================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to version control!

# ---- General ----
NODE_ENV=development
PORT=4000
# all: yerel geliştirme, cloud: merkezi lisans/ortak menü, local: müşteri bilgisayarı
RUNTIME_MODE=all

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rest_otm?schema=public

# ---- Redis ----
# Yalnızca geliştirme/gelecek cache çalışmaları için; müşteri çalışma zamanı buna bağlı değildir.
REDIS_URL=redis://localhost:6379

# ---- JWT Authentication ----
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---- License Service (Cloud runtime only) ----
# Gerçek Ed25519 özel anahtarını yalnızca bulut secret kasasında tutun; müşteri paketine koymayın.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_cloud_only_key\n-----END PRIVATE KEY-----"
LICENSE_KEY_ACTIVE_PEPPER_VERSION=v1
# Rotasyon: yeni version/secret ekle, active version'i degistir; eski pepper'i
# tum kayitlar yeniden hashlenene kadar ring'de tut. Her secret >=32 byte olmali.
LICENSE_KEY_PEPPERS={"v1":"openssl-rand-base64-48-ile-guclu-bir-secret-uretin"}

# ---- Signed Update Publisher (Cloud runtime only) ----
# Lisans anahtarindan farkli bir Ed25519 keypair kullanin. Private parca asla
# Windows/local artifact'a girmez; public parca installer ile dagitilir.
UPDATE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_cloud_only_update_key\n-----END PRIVATE KEY-----"
UPDATE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_update_public_key\n-----END PUBLIC KEY-----"
# Artifact byte'lari API veritabaninda tutulmaz. Yalniz bu canonical HTTPS
# origin'lerdeki immutable/hash'li dosya URL metadata'si yayinlanabilir.
UPDATE_ARTIFACT_ALLOWED_ORIGINS=https://updates.your-domain.example

# ---- Local License Runtime (Local runtime only) ----
LOCAL_LICENSE_SERVER_URL=https://your-render-control-plane.example
MENU_PUBLIC_ID_SECRET=replace_with_a_random_32_plus_character_cloud_secret
LOCAL_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_public_key\n-----END PUBLIC KEY-----"
LOCAL_LICENSE_DATA_DIR=./data/license
LOCAL_LICENSE_HEARTBEAT_MS=3600000
LOCAL_LICENSE_RETRY_MS=300000
LOCAL_LAN_HOSTNAME=restotm-ab12.local
APP_VERSION=0.1.0

# ---- Signed Update Runtime (Local runtime only) ----
LOCAL_UPDATE_MANIFEST_URL=https://your-render-control-plane.example/api/updates/v1/manifest
# Lisans imza anahtarindan ayri Ed25519 update public key kullanilir.
LOCAL_UPDATE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_update_public_key\n-----END PUBLIC KEY-----"
LOCAL_UPDATE_ALLOWED_ORIGINS=https://your-render-control-plane.example
LOCAL_UPDATE_DATA_DIR=./data/update
LOCAL_UPDATE_CHANNEL=stable
LOCAL_UPDATE_DATABASE_SCHEMA_VERSION=1

# Kurulum basina benzersiz uretilir; Windows'ta DPAPI LocalMachine ile korunur.
TABLE_QR_SIGNING_SECRET=replace_with_random_48_plus_character_table_qr_secret

# ---- Local PostgreSQL & Backup (Local runtime only) ----
# Production Windows installer mutlak ProgramData/ayri disk yollarini yazar.
LOCAL_POSTGRES_DATA_DIR=./data/postgres
LOCAL_BACKUP_DIR=./backups
LOCAL_BACKUP_EXTERNAL_DIR=./backups-external
# warn: ayni diskte calisir ve gorunur uyari verir; require-separate: farkli volume zorunlu.
LOCAL_BACKUP_EXTERNAL_VOLUME_POLICY=warn
# Production'da supervisor DPAPI ile cozer; canonical Base64 tam 32 byte olmalidir.
LOCAL_BACKUP_KEY_BASE64=paWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaU=
LOCAL_BACKUP_KEY_ID=development-only
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_EXTERNAL_RETENTION_DAILY=30
BACKUP_EXTERNAL_RETENTION_WEEKLY=12
BACKUP_EXTERNAL_RETENTION_MONTHLY=24
BACKUP_RESTORE_VERIFICATION_INTERVAL_MS=604800000
BACKUP_RESTORE_VERIFICATION_RETRY_MS=21600000

# ---- Admin Dashboard (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---- Waiter PWA (Next.js) ----
# Uses same API/WS URLs as admin

# ---- Local LAN Gateway (Local runtime only) ----
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=8787
# Installer makine adi, mDNS adi ve gerekirse sabit yerel adlari yazar.
GATEWAY_ALLOWED_HOSTS=restotm-ab12.local,restotm-ab12
GATEWAY_ALLOW_PRIVATE_IP_HOSTS=true
GATEWAY_API_TARGET=http://127.0.0.1:4100
GATEWAY_ADMIN_TARGET=http://127.0.0.1:3100
GATEWAY_WAITER_TARGET=http://127.0.0.1:3200
GATEWAY_MENU_TARGET=http://127.0.0.1:3300
GATEWAY_UPSTREAM_TIMEOUT_MS=30000
GATEWAY_MAX_CONTENT_LENGTH_BYTES=10485760

# ---- Local QR Menu child (server-side only) ----
CLOUD_MENU_API_URL=https://your-render-control-plane.example/api
# Local Windows build: MENU_BASE_PATH=/menu. Cloud legacy build: bos birakilir.
MENU_BASE_PATH=

# ---- Print Agent ----
PRINT_AGENT_WS_URL=http://localhost:4000
PRINT_AGENT_SECRET=your_print_agent_secret_here
PRINT_AGENT_DATA_DIR=/var/lib/rest-otm/print-agent

# ---- Super Admin (Initial Setup) ----
# Yalnızca cloud runtime için zorunludur.
SUPER_ADMIN_EMAIL=admin@restotm.com
SUPER_ADMIN_PASSWORD=change_me_immediately
