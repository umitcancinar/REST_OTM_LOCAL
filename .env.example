# ==========================================
# REST_OTM — Environment Variables Template
# ==========================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to version control!

# ---- General ----
NODE_ENV=development
PORT=4000
# all: yerel geliştirme, cloud: merkezi lisans/ortak menü, local: müşteri bilgisayarı
RUNTIME_MODE=all

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rest_otm?schema=public

# ---- Redis ----
# Yalnızca geliştirme/gelecek cache çalışmaları için; müşteri çalışma zamanı buna bağlı değildir.
REDIS_URL=redis://localhost:6379

# ---- JWT Authentication ----
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---- License Service (Cloud runtime only) ----
# Gerçek Ed25519 özel anahtarını yalnızca bulut secret kasasında tutun; müşteri paketine koymayın.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_cloud_only_key\n-----END PRIVATE KEY-----"

# ---- Local License Runtime (Local runtime only) ----
LOCAL_LICENSE_SERVER_URL=https://your-render-control-plane.example
LOCAL_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_public_key\n-----END PUBLIC KEY-----"
LOCAL_LICENSE_DATA_DIR=./data/license
LOCAL_LICENSE_HEARTBEAT_MS=3600000
LOCAL_LICENSE_RETRY_MS=300000
APP_VERSION=0.1.0

# ---- Local PostgreSQL & Backup (Local runtime only) ----
# Production Windows installer mutlak ProgramData/ayri disk yollarini yazar.
LOCAL_POSTGRES_DATA_DIR=./data/postgres
LOCAL_BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ---- Admin Dashboard (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---- Waiter PWA (Next.js) ----
# Uses same API/WS URLs as admin

# ---- Print Agent ----
PRINT_AGENT_WS_URL=http://localhost:4000
PRINT_AGENT_SECRET=your_print_agent_secret_here

# ---- Super Admin (Initial Setup) ----
# Yalnızca cloud runtime için zorunludur.
SUPER_ADMIN_EMAIL=admin@restotm.com
SUPER_ADMIN_PASSWORD=change_me_immediately
