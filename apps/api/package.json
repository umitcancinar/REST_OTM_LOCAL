{
  "name": "@rest-otm/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/app.js",
    "start:cloud": "prisma migrate deploy && node dist/cloud.js",
    "start:local": "prisma migrate deploy && node dist/local.js",
    "license-keys:backfill": "ts-node src/modules/license-admin/license-key-backfill.ts",
    "lint": "eslint src/",
    "test": "tsc && node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@prisma/client": "^6.3.0",
    "@rest-otm/license": "workspace:*",
    "@rest-otm/receipt-core": "workspace:*",
    "@rest-otm/shared-types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "prisma": "^6.3.0",
    "qrcode": "1.5.4",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.6",
    "eslint": "^9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2"
  }
}
