// ==========================================
// Prisma Schema — Multi-Tenant Restaurant SaaS
// ==========================================
// PostgreSQL with Row-Level Security design.
// Every table includes tenantId for data isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ────────────────────────────────────────

model Tenant {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  customDomain          String?   @unique
  logo                  String?
  address               String?
  phone                 String?
  email                 String?
  settings              Json      @default("{}")
  isActive              Boolean   @default(true)
  /**
   * Tenant basina print-agent kimlik dogrulama sirri. Null ise (henuz
   * uretilmemis eski kayitlar) socket.server.ts global PRINT_AGENT_SECRET'a
   * duser — geriye donuk uyumluluk icin bilerek boyle.
   */
  printAgentSecret      String?
  /**
   * Uyelik bitis tarihi. Null = sure hic ayarlanmamis (kontrol devre disi,
   * mevcut musterileri kilitlememek icin varsayilan).
   */
  subscriptionExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  licenses               License[]
  users                  User[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  tables                 RestaurantTable[]
  orders                 Order[]
  orderCounters          OrderCounter[]
  orderCommands          OrderCommand[]
  printJobs              PrintJob[]
  menuProjectionOutbox   MenuProjectionOutbox[]
  menuProjectionSequence MenuProjectionSequence?
  inventoryItems         InventoryItem[]
  recipes                Recipe[]
  wasteLogs              WasteLog[]
  printerConfigs         PrinterConfig[]
  reservations           Reservation[]
  customers              Customer[]
  galleryImages          GalleryImage[]
  stories                Story[]
  reviews                Review[]
  newsletterSubs         NewsletterSubscriber[]
  invoices               Invoice[]

  @@map("tenants")
}

// ─── USER / AUTH ───────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  CHEF
  CASHIER
  WAITER
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  email        String
  passwordHash String
  name         String
  role         Role      @default(WAITER)
  pin          String? // Quick PIN login for waiters
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]        @relation("WaiterOrders")
  wasteLogs     WasteLog[]
  refreshTokens RefreshToken[]
  superAdminMfaChallenges SuperAdminMfaChallenge[]

  @@unique([tenantId, email])
  @@unique([tenantId, pin])
  @@index([tenantId])
  @@map("users")
}

// ─── LISANS ────────────────────────────────────────
// Musterinin kendi bilgisayarinda calisan kurulumun kimligi.
// Bulut tarafi lisansi URETIR ve DENETLER; lokal taraf yalnizca
// dogrular (bkz. packages/license).

enum LicenseStatus {
  /**
   * Uretildi, henuz bir bilgisayara baglanmadi.
   */
  PENDING
  /**
   * Bir makineye baglandi ve calisiyor.
   */
  ACTIVE
  /**
   * Superadmin tarafindan durduruldu (odeme yok vb.).
   */
  SUSPENDED
  /**
   * Kalici olarak iptal edildi.
   */
  REVOKED
}

model License {
  id               String        @id @default(cuid())
  tenantId         String
  /**
   * Gecis alani: eski kurulumlar backfill edilene kadar "key" kolonuna
   * maplenir. Yeni lisanslar buraya plaintext yazmaz. Backfill preflight'i
   * sifira ulastiktan sonraki contract migration'inda tamamen kaldirilacak.
   */
  legacyKey        String?       @unique @map("key")
  /**
   * Rotasyonlu server pepper ile HMAC-SHA-256; ham anahtar geri uretilmez.
   */
  keyHash          String?       @unique @db.Char(64)
  keyPepperVersion String?       @db.VarChar(32)
  /**
   * Yalniz maskeleme/destek gorunumu icin; kimlik dogrulamada kullanilmaz.
   */
  keyLast4         String?       @db.Char(4)
  status           LicenseStatus @default(PENDING)

  /**
   * Baglandigi makinenin parmak izi. Null ise henuz aktive edilmemis.
   * Ikinci bir makinede ayni anahtarla aktivasyon denendiginde burasi
   * dolu oldugu icin reddedilir.
   */
  hardwareId      String?
  /**
   * Destek ekraninda musterinin okuyabilecegi kisa kod.
   */
  hardwareIdShort String?
  activatedAt     DateTime?

  /**
   * Uyelik bitisi. Lisans her yenilendiginde bu tarih imzalanir.
   */
  expiresAt DateTime

  /**
   * Internet kesintisinde kac gun calisabilecegi.
   */
  graceDays Int @default(7)

  /**
   * Acik ozellikler: einvoice, pos, inventory ...
   */
  features String[] @default([])

  /**
   * Son yoklama bilgileri — superadmin panelinde "canli mi" gostergesi.
   * Uzun suredir yoklama gelmiyorsa ya kapali ya da engellenmis demektir.
   */
  lastHeartbeatAt DateTime?
  lastHeartbeatIp String?
  appVersion      String?

  /**
   * Kurcalama supheleri burada birikir (imza hatasi, saat oynatma,
   * farkli donanimdan gelen yoklama). Superadmin gorup arayabilsin.
   */
  suspiciousCount  Int       @default(0)
  lastSuspiciousAt DateTime?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs LicenseAuditLog[]

  @@index([tenantId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("licenses")
}

/**
 * Superadmin lisans islemlerinin degistirilemez olay gunlugu.
 * Her kayit ilgili lisans degisikligiyle AYNI transaction'da yazilir.
 */
enum LicenseAuditAction {
  CREATED
  UPDATED
  EXTENDED
  SUSPENDED
  RESUMED
  REVOKED
  ACTIVATION_RESET
  REBOUND
}

model LicenseAuditLog {
  id         String             @id @default(cuid())
  licenseId  String
  operatorId String
  action     LicenseAuditAction
  metadata   Json               @default("{}")
  timestamp  DateTime           @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([licenseId, timestamp])
  @@index([operatorId, timestamp])
  @@map("license_audit_logs")
}

// ─── REFRESH TOKEN / OTURUM ────────────────────────
// Onceki surumde refresh token hicbir yerde saklanmiyordu. Sonuclari:
//   - "Cikis yap" token'i gercekte iptal etmiyordu; calinan bir kopya
//     suresi dolana kadar (7 gun) gecerli kalmaya devam ediyordu.
//   - Superadmin, uyeligi biten bir restorani anlik olarak disari atamiyordu.
//
// Token'in kendisi degil SHA-256 ozeti saklanir — sifre hash'lemeyle ayni
// mantik: veritabani sizarsa eldeki ozetlerle oturum acilamaz.

enum UpdateReleaseStatus {
  DRAFT
  PUBLISHED
  REVOKED
}

enum UpdateReleaseAuditAction {
  CREATED
  PUBLISHED
  REVOKED
}

/// Cloud-only Windows release metadata; tenant operasyon verisi tutmaz.
model UpdateRelease {
  id                String              @id @default(cuid())
  version           String              @db.VarChar(128)
  channel           String              @db.VarChar(32)
  minCurrentVersion String              @db.VarChar(128)
  maxCurrentVersion String              @db.VarChar(128)
  issuedAt          DateTime
  expiresAt         DateTime
  migration         Json
  status            UpdateReleaseStatus @default(DRAFT)
  /// Canonical JSON tam olarak bu byte dizisi uzerinden Ed25519 imzalanir.
  manifestPayload   String?             @db.Text
  signature         String?             @db.VarChar(128)
  manifestSha256    String?             @db.Char(64)
  createdBy         String
  publishedAt       DateTime?
  revokedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  artifacts UpdateReleaseArtifact[]
  auditLogs UpdateReleaseAuditLog[]

  @@unique([channel, version])
  @@index([channel, status, issuedAt])
  @@index([status, expiresAt])
  @@map("update_releases")
}

model UpdateReleaseArtifact {
  id        String   @id @default(cuid())
  releaseId String
  position  Int
  role      String   @db.VarChar(32)
  fileName  String   @db.VarChar(128)
  platform  String   @db.VarChar(32)
  sha256    String   @db.Char(64)
  sizeBytes BigInt
  /// Artifact binary cloud API'de tutulmaz; yalniz allowlist'li HTTPS metadata.
  sourceUrl String   @db.VarChar(2048)
  createdAt DateTime @default(now())

  release UpdateRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([releaseId, position])
  @@unique([releaseId, fileName])
  @@index([releaseId])
  @@map("update_release_artifacts")
}

model UpdateReleaseAuditLog {
  id         String                   @id @default(cuid())
  releaseId  String
  operatorId String
  action     UpdateReleaseAuditAction
  metadata   Json                     @default("{}")
  ipAddress  String?                  @db.VarChar(64)
  userAgent  String?                  @db.VarChar(512)
  timestamp  DateTime                 @default(now())

  release UpdateRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([releaseId, timestamp])
  @@index([operatorId, timestamp])
  @@map("update_release_audit_logs")
}

model RefreshToken {
  id         String    @id @default(cuid())
  /**
   * Token'in SHA-256 ozeti. Token'in kendisi hicbir zaman saklanmaz.
   */
  tokenHash  String    @unique
  userId     String
  /**
   * Tenant bazli toplu iptal icin (uyelik bitisi, hesap pasiflestirme).
   */
  tenantId   String?
  expiresAt  DateTime
  /**
   * Dolu ise token gecersiz. Silmek yerine isaretliyoruz ki yeniden
   * kullanim denemesi (calinti token belirtisi) tespit edilebilsin.
   */
  revokedAt  DateTime?
  /**
   * Hangi token'in yerine uretildigi — rotasyon zincirini takip eder.
   */
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── SUPERADMIN MFA ───────────────────────────────
// Kodun kendisi hicbir zaman saklanmaz. Yalnizca pepper'li HMAC ozeti
// PostgreSQL'e yazilir. consumedAt atomik olarak doldurulmadan oturum token'i
// uretilemez; boylece ayni challenge iki Render instance'inda dahi replay
// edilemez.
model SuperAdminMfaChallenge {
  id            String    @id
  userId        String
  codeHash      String    @db.Char(64)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  requestedIp   String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("superadmin_mfa_challenges")
}

// ─── CUSTOMERS ─────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  email       String?
  address     String?
  notes       String?
  companyName String?
  taxOffice   String?
  taxId       String? // VKN or TCKN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

// ─── MENU ──────────────────────────────────────────

model MenuCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId])
  @@map("menu_categories")
}

enum Department {
  KITCHEN
  BAR
  GRILL
  PASTRY
  COLD
  CASHIER
  PAKET
  POS
}

model MenuItem {
  id              String     @id @default(cuid())
  tenantId        String
  categoryId      String
  name            String
  description     String?
  image           String?
  basePrice       Float
  taxRate         Float      @default(20) // KDV Oranı (%)
  portionOptions  Json       @default("[]") // PortionOption[]
  extras          Json       @default("[]") // MenuExtra[]
  department      Department @default(KITCHEN)
  preparationTime Int? // minutes
  calories        Int? // kcal — kalori bilgisi
  allergens       Json       @default("[]") // string[]
  extraInfo       String? // Detailed information for modals
  badge           String? // e.g., "New", "Popular", "Chef's Recommendation"
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  recipes  Recipe[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

enum MenuProjectionOutboxStatus {
  PENDING
  LEASED
  RETRY
  ACKED
  DEAD
}

/**
 * Local-only transactional full-snapshot publication outbox.
 */
model MenuProjectionOutbox {
  id             String                     @id @default(cuid())
  tenantId       String
  version        Int
  checksum       String                     @db.Char(64)
  payload        Json
  status         MenuProjectionOutboxStatus @default(PENDING)
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(12)
  nextAttemptAt  DateTime                   @default(now())
  leaseOwner     String?                    @db.VarChar(96)
  leaseToken     String?                    @db.VarChar(64)
  leaseExpiresAt DateTime?
  lastError      String?                    @db.VarChar(1000)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  acknowledgedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, createdAt])
  @@map("menu_projection_outbox")
}

/**
 * Local-only monotonic publication sequence; incremented in the mutation tx.
 */
model MenuProjectionSequence {
  tenantId  String   @id
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("menu_projection_sequences")
}

/**
 * Cloud-only read projection. It has deliberately no FK to operational Tenant.
 */
model MenuPublication {
  tenantId       String    @id
  publicId       String    @unique @db.VarChar(64)
  slug           String    @unique @db.VarChar(128)
  customDomain   String?   @unique @db.VarChar(253)
  version        Int
  sourceChecksum String    @db.Char(64)
  checksum       String    @db.Char(64)
  payload        Json
  publishedAt    DateTime  @default(now())
  disabledAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([checksum])
  @@map("menu_publications")
}

// ─── TABLES ────────────────────────────────────────

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model RestaurantTable {
  id        String      @id @default(cuid())
  tenantId  String
  number    String
  zone      String      @default("Salon")
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  positionX Float?
  positionY Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("restaurant_tables")
}

// ─── RESERVATIONS ──────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id              String            @id @default(cuid())
  tenantId        String
  tableId         String
  customerName    String
  customerPhone   String?
  guestCount      Int               @default(2)
  reservationTime DateTime
  status          ReservationStatus @default(CONFIRMED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tableId])
  @@index([tenantId, reservationTime])
  @@map("reservations")
}

// ─── ORDERS ────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  tableId        String?
  customerId     String?
  waiterId       String?
  orderNumber    String
  type           String      @default("DINE_IN") // DINE_IN | TAKEAWAY
  isDeleted      Boolean     @default(false)
  status         OrderStatus @default(PENDING)
  totalAmount    Float       @default(0)
  taxAmount      Float       @default(0)
  serviceCharge  Float       @default(0)
  discountAmount Float       @default(0)
  grandTotal     Float       @default(0)
  paymentMethod  String?
  paidAmount     Float       @default(0)
  payments       Json?       @default("[]")
  notes          String?
  invoice        Invoice?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table               RestaurantTable? @relation(fields: [tableId], references: [id])
  customer            Customer?        @relation(fields: [customerId], references: [id])
  waiter              User?            @relation("WaiterOrders", fields: [waiterId], references: [id])
  subChecks           SubCheck[]
  idempotencyCommands OrderCommand[]
  printJobs           PrintJob[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tableId])
  @@index([customerId])
  @@index([waiterId])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/**
 * Transactional sequence for human-facing order numbers. A business day is
 * currently the UTC calendar day; see order-number.policy.ts. Keeping the day
 * in the counter scope lets each tenant restart at 1 without sharing locks.
 */
model OrderCounter {
  tenantId     String
  businessDate DateTime @db.Date
  value        Int      @default(0)
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, businessDate])
  @@map("order_counters")
}

/**
 * A durable receipt for every client order-create command. This is separate
 * from Order because a command may append items to an already open table order.
 * The tenant-scoped unique key is the final defence against concurrent retries.
 */
model OrderCommand {
  id             String   @id @default(cuid())
  tenantId       String
  idempotencyKey String   @db.VarChar(128)
  payloadHash    String   @db.Char(64)
  orderId        String?
  createdItemIds String[] @default([])
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("order_commands")
}

model SubCheck {
  id            String  @id @default(cuid())
  orderId       String
  label         String  @default("Genel")
  subtotal      Float   @default(0)
  isPaid        Boolean @default(false)
  paymentMethod String?

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("sub_checks")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model OrderItem {
  id                String          @id @default(cuid())
  subCheckId        String
  menuItemId        String
  menuItemName      String
  quantity          Float           @default(1.0)
  portionOption     String          @default("Normal")
  portionMultiplier Float           @default(1.0)
  unitPrice         Float
  taxRate           Float           @default(20) // Sabitlenmiş KDV
  extras            Json            @default("[]")
  totalPrice        Float
  isTreat           Boolean         @default(false)
  notes             String?
  status            OrderItemStatus @default(PENDING)
  department        Department      @default(KITCHEN)
  createdAt         DateTime        @default(now())

  subCheck SubCheck @relation(fields: [subCheckId], references: [id], onDelete: Cascade)

  @@index([subCheckId])
  @@map("order_items")
}

// ─── INVENTORY & RECIPES ───────────────────────────

enum StockUnit {
  GRAM
  KILOGRAM
  LITER
  MILLILITER
  PIECE
  PORTION
}

model InventoryItem {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  unit          StockUnit @default(PIECE)
  currentStock  Float     @default(0)
  minStockAlert Float     @default(0)
  costPerUnit   Float     @default(0)
  supplier      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  wasteLogs         WasteLog[]

  @@index([tenantId])
  @@map("inventory_items")
}

model Recipe {
  id         String   @id @default(cuid())
  tenantId   String
  menuItemId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId])
  @@index([menuItemId])
  @@map("recipes")
}

model RecipeIngredient {
  id              String    @id @default(cuid())
  recipeId        String
  inventoryItemId String
  quantity        Float
  unit            StockUnit

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("recipe_ingredients")
}

model WasteLog {
  id              String   @id @default(cuid())
  tenantId        String
  inventoryItemId String
  quantity        Float
  reason          String
  loggedById      String
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  loggedBy      User          @relation(fields: [loggedById], references: [id])

  @@index([tenantId])
  @@map("waste_logs")
}

// ─── PRINTER CONFIG ────────────────────────────────

model PrinterConfig {
  id           String       @id @default(cuid())
  tenantId     String
  name         String // e.g. "Mutfak Yazıcısı", "Bar Yazıcısı"
  type         String       @default("ESCPOS") // ESCPOS | KDS
  ipAddress    String?
  port         Int?
  usbVendorId  String?
  usbProductId String?
  departments  Department[] // Which departments route to this printer
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]

  @@index([tenantId])
  @@map("printer_configs")
}

enum PrintJobStatus {
  PENDING
  LEASED
  RETRY
  PRINTED
  DEAD
}

/**
 * Durable print outbox. payload is the exact Socket.IO event snapshot consumed
 * by the existing print-agent renderer; receipt/layout behavior stays frozen at
 * enqueue time. Physical exactly-once is impossible across printer-write/ACK
 * crashes, so ambiguous lease recovery is retained in attempt audit rows.
 */
model PrintJob {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String?
  printerId      String?
  eventName      String         @db.VarChar(64)
  eventKey       String         @db.VarChar(96)
  idempotencyKey String         @db.VarChar(200)
  payload        Json
  status         PrintJobStatus @default(PENDING)
  attempts       Int            @default(0)
  maxAttempts    Int            @default(8)
  nextAttemptAt  DateTime       @default(now())
  leaseOwner     String?        @db.VarChar(96)
  leaseToken     String?        @db.VarChar(64)
  leaseExpiresAt DateTime?
  lastError      String?        @db.VarChar(1000)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  printedAt      DateTime?
  deadAt         DateTime?
  retainUntil    DateTime?
  reprintOfId    String?

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  printer       PrinterConfig?    @relation(fields: [printerId], references: [id], onDelete: SetNull)
  attemptsAudit PrintJobAttempt[]
  reprintOf     PrintJob?         @relation("PrintJobReprints", fields: [reprintOfId], references: [id], onDelete: SetNull)
  reprints      PrintJob[]        @relation("PrintJobReprints")

  @@unique([tenantId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, status, createdAt])
  @@index([orderId, eventKey])
  @@index([printerId, status])
  @@index([retainUntil])
  @@index([reprintOfId])
  @@map("print_jobs")
}

model PrintJobAttempt {
  id               String    @id @default(cuid())
  jobId            String
  attemptNumber    Int
  leaseOwner       String    @db.VarChar(96)
  dispatchToken    String    @db.VarChar(64)
  dispatchedAt     DateTime  @default(now())
  acknowledgedAt   DateTime?
  success          Boolean?
  error            String?   @db.VarChar(1000)
  ambiguousAckLoss Boolean   @default(false)

  job PrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@unique([jobId, dispatchToken])
  @@index([jobId, dispatchedAt])
  @@map("print_job_attempts")
}

// ─── CMS & MARKETING (SITE SHOWCASE) ───────────────

model GalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("gallery_images")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Story {
  id        String    @id @default(cuid())
  tenantId  String
  title     String?
  mediaUrl  String
  mediaType MediaType @default(IMAGE)
  duration  Int       @default(5000)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("stories")
}

model Review {
  id           String   @id @default(cuid())
  tenantId     String
  customerName String
  rating       Int      @default(5)
  text         String
  source       String   @default("DIRECT")
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("reviews")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("newsletter_subscribers")
}

// ─── E-INVOICE (Uyumsoft) ──────────────────────────

enum InvoiceStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  tenantId     String
  orderId      String        @unique
  uuid         String // ETTN
  invoiceNo    String? // Fatura No (e.g. UYM2026000000001)
  status       InvoiceStatus @default(DRAFT)
  pdfUrl       String? // PDF or HTML link from Integrator
  totalAmount  Float
  taxAmount    Float
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoices")
}
