{
  "name": "@rest-otm/print-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/agent.ts",
    "build": "tsc",
    "lint": "eslint src/ test/",
    "test": "tsc && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/agent.js",
    "discover": "ts-node-dev --transpile-only src/discover.ts"
  },
  "dependencies": {
    "@rest-otm/receipt-core": "workspace:*",
    "dotenv": "^16.4.7",
    "jimp": "^0.16.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2"
  }
}
